// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/*
  npx prisma generate
  npx prisma migrate dev --name <nome>


  Talvez:
  npx prisma migrate reset


  npx prisma migrate reset --skip-seed
  npx prisma db seed
*/

// ============================================
// ENUMS (CORRIGIDOS)
// ============================================

enum PhoneType {
  telephone
  cellphone
}

enum CouponType {
  percent
  value
}

enum CardBrand {
  visa
  mastercard
  amex
  elo
  hipercard
}

enum PaymentType {
  card
  pix
  boleto
}

enum PaymentStatus {
  canceled
  refunded
  pending
  paid
}

enum SaleStatus {
  processing
  approved
  shipped
  delivered
  canceled
}

// ============================================
// AUTH
// ============================================

model authentication {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.Citext
  password  String
  blocked   Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int  @unique
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model refresh_token {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users user[]
}

model active_token {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      user     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// USER
// ============================================

model user {
  id        Int      @id @default(autoincrement())
  name      String
  birthday  DateTime
  cpf       String   @db.VarChar(11)
  isDelete  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  genderId Int
  gender   gender @relation(fields: [genderId], references: [id])

  roleId String
  role   role @relation(fields: [roleId], references: [id])

  authentication authentication?
  refresh_tokens refresh_token[]
  active_tokens  active_token[]
  phones         phone[]
  addresses      address[]
  cards          card[]
  cart_items     cart_item[]
  sales          sale[]
}

model gender {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isDelete  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users user[]
}

// ============================================
// CONTACT & ADDRESS
// ============================================

model phone {
  id        Int      @id @default(autoincrement())
  ddd       String   @db.VarChar(2)
  number    String   @db.VarChar(9)
  type      PhoneType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ddd, number])
  @@index([userId])
}

model address {
  id           Int      @id @default(autoincrement())
  nickname     String
  street       String
  number       String
  complement   String?
  neighborhood String
  zip          String   @db.VarChar(8)

  cityId Int
  city   city @relation(fields: [cityId], references: [id])

  isDelete  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)

  sales sale[]

  @@index([userId])
  @@index([cityId])
  @@unique([nickname, userId])
}

model city {
  id      Int    @id @default(autoincrement())
  name    String
  stateId Int
  state   state @relation(fields: [stateId], references: [id])

  addresses address[]

  @@unique([name, stateId])
}

model state {
  id           Int    @id @default(autoincrement())
  name         String @unique
  abbreviation String @unique @db.VarChar(2)

  cities city[]
}

// ============================================
// CARD
// ============================================

model card {
  id       Int        @id @default(autoincrement())
  nickname String
  holder   String
  brand    CardBrand
  last4    String     @db.VarChar(4)
  token    String     @unique
  primary  Boolean    @default(false)
  isDelete Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)

  payments payment[]

  @@index([userId])
  @@unique([nickname, userId])
}

// ============================================
// PRODUCT
// ============================================

model product {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  price       Float
  salePrice   Float   @default(0)
  images      String[]
  description String?
  stock       Int     @default(0)
  active      Boolean @default(true)
  isDelete    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subCategories product_sub_category[]
  cartItems     cart_item[]
  saleItems     sale_item[]
}

model sub_category {
  id        Int    @id @default(autoincrement())
  name      String @unique
  isDelete  Boolean @default(false)

  categoryId Int
  category   category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products product_sub_category[]
}

model product_sub_category {
  productId     Int
  subCategoryId  Int

  product     product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  subCategory sub_category  @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@id([productId, subCategoryId])
}

model category {
  id        Int    @id @default(autoincrement())
  name      String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subCategories sub_category[]
}

model cart_item {
  id       Int @id @default(autoincrement())
  quantity Int @default(1)
  inStock  Boolean @default(true)

  userId Int
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId Int
  product   product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

// ============================================
// SALE
// ============================================

model sale {
  id          Int        @id @default(autoincrement())
  finalPrice  Float //frete incluso
  totalPrice  Float
  freight Float
  status      SaleStatus @default(processing)
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   user @relation(fields: [userId], references: [id])

  addressId Int
  address   address @relation(fields: [addressId], references: [id])

  items   sale_item[]
  payment payment?
  coupons sale_coupon[]
}

model sale_item {
  quantity Int
  price    Float

  saleId Int
  sale   sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId Int
  product   product @relation(fields: [productId], references: [id])

  @@unique([saleId, productId])
}

model payment {
  id     Int @id @default(autoincrement())
  saleId Int @unique

  type   PaymentType
  status PaymentStatus
  amount Float

  cardId Int?
  card   card? @relation(fields: [cardId], references: [id])

  sale sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

// ============================================
// COUPON
// ============================================

model coupon {
  id       Int        @id @default(autoincrement())
  code     String     @unique
  type     CouponType
  discount Float
  maxUses  Int @default(1)

  sales sale_coupon[]
}

model sale_coupon {
  saleId   Int
  couponId Int

  type     CouponType
  discount Float?

  sale   sale   @relation(fields: [saleId], references: [id])
  coupon coupon @relation(fields: [couponId], references: [id])

  @@unique([saleId, couponId])
}