// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}




// ============================================
// ENUMS
// ============================================

enum phone_type {
  telephone
  cellphone
}

enum state {
  AC
  AL
  AP
  AM
  BA
  CE
  DF
  ES
  GO
  MA
  MT
  MS
  MG
  PA
  PB
  PR
  PE
  PI
  RJ
  RN
  RS
  RO
  RR
  SC
  SP
  SE
  TO
}

enum card_brand {
  VISA
  MASTERCARD
  AMEX
  ELO
  HIPERCARD
}




// ============================================
// AUTH
// ============================================

model authentication {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  blocked   Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int  @unique
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model refresh_token {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users user[]
}



// ============================================
// USER
// ============================================

model user {
  id             Int      @id @default(autoincrement())
  name           String
  birthday DateTime
  cpf            String   @unique @db.VarChar(11)
  isDelete       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  genderId Int
  gender   gender @relation(fields: [genderId], references: [id])
  @@index([genderId])

  roleId String
  role   role   @relation(fields: [roleId], references: [id])
  @@index([roleId])

  authentication authentication?
  refresh_tokens refresh_token[]
  phones         phone[]
  addresses      address[]
  cards          card[]
  cart           cart?
  sales          sale[]
}

model gender {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users user[]
}



// ============================================
// CONTACT & ADDRESS
// ============================================

model phone {
  id        Int        @id @default(autoincrement())
  ddd       String     @db.VarChar(2)
  number    String     @db.VarChar(9)
  type      phone_type
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  userId Int
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ddd, number])
  @@index([userId])
}

model address {
  id            Int      @id @default(autoincrement())
  street        String
  streetType    String
  residenceType String
  neighbor      String
  number        String
  zip           String   @db.VarChar(8)
  city          String
  state         state
  observation   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId Int
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  sales sale[]
}




// ============================================
// CARD
// ============================================

model card {
  id        Int        @id @default(autoincrement())
  nickname  String
  holder    String
  brand     card_brand
  last4     String     @db.VarChar(4)
  token     String     @unique
  primary   Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  userId Int
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)

  salePayments sale_payment[]

  @@index([userId])
}



model product {
  id       Int    @id @default(autoincrement())
  name     String
  price    Float
  image    String
  quantity Int   
  active   Boolean
  isDelete Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId Int
  category   category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  subCategoryId Int
  subCategory   sub_category @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  cartItems cart_item[]
  saleItems sale_item[]
}

model category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  isDelete Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products product[]
}

model sub_category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  isDelete Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products product[]
}

model cart {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  userId    Int        @unique
  user      user       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     cart_item[]
}

model cart_item {
  id        Int @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int @default(1)

  cart    cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model sale {
  id         Int      @id @default(autoincrement())
  totalValue Float
  status     String   @default("processamento")
  createdAt  DateTime @default(now())

  userId     Int
  user     user          @relation(fields: [userId], references: [id])

  addressId  Int
  address  address      @relation(fields: [addressId], references: [id])

  couponId   Int?
  coupon   coupon?       @relation(fields: [couponId], references: [id])
  items    sale_item[]
  payments sale_payment[]
}

model sale_item {
  id        Int   @id @default(autoincrement())
  quantity  Int
  price     Float

  saleId    Int
  sale    sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId Int
  product product @relation(fields: [productId], references: [id])
}

model sale_payment {
  id     Int   @id @default(autoincrement())
  saleId Int
  cardId Int
  amount Float

  sale sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  card card @relation(fields: [cardId], references: [id])
}

model coupon {
  id                 Int    @id @default(autoincrement())
  code               String? @unique
  discountPercentage Int?
  discountValue      Float?

  sales sale[]
}
